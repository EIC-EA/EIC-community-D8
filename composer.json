        "drupal/search_api_solr": "4.2.10",
        "drupal/search_api_sorts": "^1.1",
        "drupal/search_api_spellcheck": "^4.0",
        "drupal/seven": "^1.0",
        "drupal/smart_trim": "^2.0",
        "drupal/smtp": "^1.4",
        "drupal/social_link_field": "^2.1",
        "drupal/stable": "^2.1",
        "drupal/subpathauto": "^1.1",
        "drupal/twig_field_value": "^2.0",
        "drupal/typed_link": "^2.0",
        "drupal/ui_patterns": "^1.2",
        "drupal/views_autocomplete_filters": "^1.3",
        "drupal/views_bulk_operations": "^4.2",
        "drupal/views_data_export": "^1.5",
        "drupal/views_data_export_phpspreadsheet": "^2.0",
        "drupal/views_fields_on_off": "^2.0",
        "drupal/workflow_buttons": "^1.0@beta",
        "drush/drush": "^12",
        "mglaman/composer-drupal-lenient": "^1.0",
        "mottie/tablesorter": "^2.32",
        "openeuropa/ecl-twig-loader": "^4.0",
        "openeuropa/oe_authentication": "^1.13",
        "openeuropa/oe_media": "^1.13",
        "openeuropa/oe_time_caching": "^1.1",
        "openeuropa/oe_webtools": "^1.26.0",
        "softcreatr/jsonpath": "0.8",
        "webmozart/path-util": "^2.3",
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "require-dev": {
        "drevops/behat-screenshot": "^1.2",
        "drupal/core-dev": "10.4.*",
        "drupal/data_fixtures": "^1.8",
        "drupal/devel": "^5.1",
        "drupal/drupal-extension": "^5.1",
        "drupal/queue_ui": "^3.1",
        "drupal/upgrade_status": "^4.3",
        "ec-europa/toolkit": "^4.1",
        "mglaman/phpstan-drupal": "^1.3",
        "palantirnet/drupal-rector": "^0.20.3",
        "phpspec/prophecy-phpunit": "^2",
        "rdx/behat-variables": "^1.2"
    },
    "scripts": {
        "post-install-cmd": [
            "DrupalComposer\\DrupalScaffold\\Plugin::scaffold"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "extra": {
        "merge-plugin": {
            "require": [
                "composer.libraries.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": true,
            "merge-extra-deep": true,
            "merge-scripts": true
        },
        "artifacts": {
            "openeuropa/oe_theme": {
                "dist": {
                    "url": "https://github.com/4hardfire/oe_theme/archive/Issue-737_Fix_drupal_9_compatibilities.zip",
                    "type": "zip"
                }
            }
        },
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "composer-exit-on-patch-failure": true,
        "patches-file": "composer.patches.json",
        "enable-patching": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/libraries/ckeditor/plugins/{$name}": [
                "type:ckeditor-plugin"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "autoload-dev": {
            "psr-4": {
                "OpenEuropa\\Site\\Tests\\": "./tests/",
                "Drupal\\Tests\\oe_media\\": "./web/modules/contrib/oe_media/tests/src/"
            }
        },
        "conflict": {
            "drupal/drupal": "*"
        },
        "config": {
            "sort-packages": true,
            "allow-plugins": {
                "composer/installers": true,
                "cweagans/composer-patches": true,
                "dealerdirect/phpcodesniffer-composer-installer": true,
                "drupal/core-composer-scaffold": true,
                "mglaman/composer-drupal-lenient": true,
                "php-http/discovery": true,
                "phpstan/extension-installer": true,
                "tbachert/spi": true,
                "wikimedia/composer-merge-plugin": true
            }
        },
        "drupal-lenient": {
            "allowed-list": ["drupal/aws_sqs", "drupal/ckeditor_oembed"]
        }
    },
    "provide": {
        "drupal/book": "*"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "tbachert/spi": true,
            "cweagans/composer-patches": true,
            "phpstan/extension-installer": true,
            "drupal/core-composer-scaffold": true,
            "mglaman/composer-drupal-lenient": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    }
}
