{% if size == 2 %}
  {% set col_size = "6" %}
{% elseif size == 3 %}
  {% set col_size = "4" %}
{% elseif size == 4 %}
  {% set col_size = "3" %}
{% else %}
  {% set col_size = "12" %}
{% endif %}

<div {{ attributes.addClass('columns ecl-container ecl-u-mt-xl ecl-u-mb-xl') }}">
  <div class="ecl-row">
    {% for item in items %}
        <div class="ecl-col-{{ col_size }} ecl-u-mb-xl">
          {{ item }}
        </div>
    {% endfor %}
  </div>
</div>
