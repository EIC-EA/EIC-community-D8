<div class="report-section">
  <div class="report-list__label-total">
    <div class="report-list__label">{{ title }}</div>
    <div class="report-list__total">{{ items|length }}</div>
  </div>
  <div class="report-list {% if link and items|length %}report-list--with-link{% endif %}">
    {% if items|length %}
      {{ link }}
      {% for item in items %}
        <div class="report-list__item">
          <span>{{ item.date }}</span> <a href="{{ item.url }}">{{ item.value }}</a>
        </div>
      {% endfor %}
    {% else %}
      <div class="report-list__item report-list__item--no-results">
        <span><em>{{ "No results." }}</em></span>
      </div>
    {% endif %}
  </div>
</div>
