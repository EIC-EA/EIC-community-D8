      ],
    ],
    'dashboards_homepage' => [
      'variables' => [
        'title' => '',
        'dashboards' => NULL,
        'listings' => NULL,
      ],
    ],
    'columns' => [
      'variables' => [
        'items' => '',
        'size' => '',
        'attributes' => [],
      ],
    ],
    'cta_card' => [
      'variables' => [
        'title' => '',
        'link' => '',
        'icon' => '',
        'variant' => '',
        'path' => '',
      ],
    ],
    'number_and_link' => [
      'variables' => [
        'title' => '',
        'number' => '',
        'link' => '',
      ],
    ],
    'chart_pie' => [
      'variables' => [
        'title' => '',
        'data' => '',
        'size' => '',
      ],
    ],
    'chart_with_menu' => [
      'variables' => [
        'chart' => '',
        'menu' => '',
      ],
    ],
    'jump_menu' => [
      'variables' => [
        'wrapper_attributes' => [],
        'placeholder' => '',
        'title' => '',
        'title_attributes' => [],
        'items' => [],
        'attributes' => [],
      ],
    ],
    'title_link_list' => [
      'variables' => [
        'title' => '',
        'link' => '',
        'list' => '',
      ],
    ],
    'tabs' => [
