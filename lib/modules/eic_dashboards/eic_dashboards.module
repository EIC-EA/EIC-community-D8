  ];
}

/**
 * Implements hook_page_attachments().
 */
function eic_dashboards_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'eic_dashboards/general';
  $attachments['#attached']['library'][] = 'eic_dashboards/scripts';
}

/**
 * Implements hook_page().
 */
function eic_dashboards_preprocess_page(&$variables) {
  $variables['#attached']['library'][] = 'eic_dashboards/dashboards_menu';
}

/**
 * Implements hook_views_data_alter().
 */
function eic_dashboards_views_data_alter(array &$data) {
  $data['users']['user_organisation_group_memberships'] = [
    'title' => t('User organisation group memberships'),
    'group' => t('Users'),
    'field' => [
      'title' => t('User organisation group memberships'),
      'help' => t('Retrieves the organisations a user belongs to.'),
      'id' => 'user_organisation_group_memberships',
    ],
  ];
}

/**
 * Create aliases for given group paths.
 */
function _eic_communities_create_alias($group_id, $group_name, $group_paths) {
  foreach ($group_paths as $group_path) {
    PathAlias::create([
      'path' => '/group/' . $group_id . '/' . $group_path,
      'alias' => '/communities/' . $group_name . '/' . $group_path,
    ])->save();
  }
}

/**
 * Prepares variables for EIC Dashboard jump menu template.
 *
 * Default template: jump-menu.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - items: An array of items to be displayed in the select.
 *   - title: A title to be prepended to the list.
 */
function template_preprocess_jump_menu(array &$variables) {
  $variables['wrapper_attributes'] = new Attribute($variables['wrapper_attributes']);
  $variables['title_attributes'] = new Attribute($variables['title_attributes']);

  foreach ($variables['items'] as &$item) {
    $attributes = [];
    if (isset($item['#attributes'])) {
      $attributes = $item['#attributes'];
    }
    // Set the item's value and attributes for the template.
    $item = [
      'label' => $item['#label'],
      'value' => $item['#value'],
      'attributes' => new Attribute($attributes),
    ];
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function eic_dashboards_form_views_exposed_form_alter(&$form, FormStateInterface $form_state, $form_id) {
 if ($form['#id'] === 'views-exposed-form-dashboard-members-list-page-1') {
   $form['status_1']['#options'][1] = t('Enabled');
   $form['status_1']['#options'][0] = t('Disabled');
 }
}
