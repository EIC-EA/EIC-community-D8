{% if items is not empty %}
  <div class="ecl-inline-actions.html.twig'>
    <div class="ecl-inline-actions__items">
      {% for item in items %}
        <div class="ecl-inline-actions__item">
          {% include "@ecl/link/link.html.twig" with item|default({}) only %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}
