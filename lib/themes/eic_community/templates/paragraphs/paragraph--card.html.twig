{% extends "@paragraphs/paragraph" %}
{% block paragraph %}
  {% block content %}
    {% include "@ecl/card/card" with {
      card: {
        title: {
          label: paragraph_content.title,
        },
        image: {
          src: paragraph_content.image.src,
          alt: paragraph_content.image.alt,
        },
        description: paragraph_content.description,
      }
    } only %}
  {% endblock %}
{% endblock paragraph %}
