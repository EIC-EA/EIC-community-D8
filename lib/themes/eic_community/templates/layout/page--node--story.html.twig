{% extends "@theme/patterns/layout/base.html.twig" %}

{% block page_header %}
  {% set extra_classes =
    [
      "ecl-editorial-header--story",
      editorial_header.moderation_state ? ' ecl-editorial-header--is-' ~ editorial_header.moderation_state,
    ]|join(' ')|trim %}

  {% include "@theme/patterns/compositions/editorial-header.html.twig" with editorial_header|default({})|merge({
    extra_classes: extra_classes,
    is_stories: true
  }) %}

  {% include "@theme/patterns/compositions/hero.html.twig" with hero|default({}) %}
{% endblock %}
